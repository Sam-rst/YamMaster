generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  username    String       @unique
  password    String
  avatar      String       @default("🎲")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  gamePlayers GamePlayer[]

  @@map("users")
}

model Game {
  id        String       @id @default(uuid())
  mode      GameMode
  status    GameStatus   @default(IN_PROGRESS)
  reason    String?
  createdAt DateTime     @default(now())
  endedAt   DateTime?
  turns     Json?
  players   GamePlayer[]

  @@map("games")
}

model GamePlayer {
  id           String           @id @default(uuid())
  gameId       String
  userId       String?
  playerNumber Int
  isBot        Boolean          @default(false)
  score        Int              @default(0)
  tokensLeft   Int              @default(12)
  result       GamePlayerResult @default(PENDING)
  difficulty   BotDifficulty?
  game         Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id])

  @@unique([gameId, playerNumber])
  @@map("game_players")
}

enum GameMode {
  ONLINE
  VS_BOT
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
}

enum GamePlayerResult {
  PENDING
  WIN
  LOSE
  DRAW
}

enum BotDifficulty {
  EASY
  MEDIUM
  HARD
}
