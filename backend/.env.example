PORT=3000
DEV_MODE=false

# URL de connexion PostgreSQL (requis)
# Avec Docker Compose local :
DATABASE_URL=postgresql://yammaster:yammaster@localhost:5432/yammaster

# Origines CORS autorisées (séparées par des virgules)
# Si non défini, accepte toutes les origines (dev uniquement)
# En production : ALLOWED_ORIGINS=https://yammaster.example.com,https://yammaster-app.example.com
ALLOWED_ORIGINS=
